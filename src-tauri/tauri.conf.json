{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sito",
  "identifier": "io.github.lukaszkalnik.sito",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sito",
        "width": 1280,
        "height": 800,
        "center": true,
        "visible": false,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost thumb: http://thumb.localhost photo: http://photo.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_THE_CONTENTS_OF_sito-updater.key.pub",
      "endpoints": [
        "https://github.com/lukaszkalnik/sito/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "publisher": "Lukasz Kalnik",
    "copyright": "© 2026 Lukasz Kalnik",
    "category": "Photography",
    "shortDescription": "Wybiera najlepsze zdjęcie z serii podobnych ujęć",
    "longDescription": "Sito przesiewa galerię zdjęć, znajduje serie podobnych ujęć i podpowiada, które zdjęcie z każdej serii zostawić. Działa lokalnie, bez internetu.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "installer/installer.nsi",
        "languages": [
          "Polish"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Polish": "installer/Polish.nsh"
        }
      }
    },
    "createUpdaterArtifacts": true
  }
}
